# Copie para backend/.env (o .env não vai para o Git).
# Na cloud, cadastre estas variáveis no painel do provedor.

# Porta HTTP (a plataforma cloud costuma definir sozinha)
PORT=3000

# Banco: use DATABASE_URL (cloud) OU as variáveis DATABASE_* (local/docker compose)
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
DATABASE_HOST=localhost
DATABASE_PORT=5482
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app_db
# true quando o banco gerenciado exige SSL e a URL não traz sslmode
DATABASE_SSL=false
# Cria/atualiza as tabelas automaticamente (padrão true no MVP)
DATABASE_SYNC=true

# Segredo dos tokens de login (defina um valor próprio na cloud)
JWT_SECRET=troque-este-valor

# Dados de demonstração (síndico, empresa, condomínios e sensores)
SEED_DEMO=true
# Senha das contas de demonstração (padrão: Coillect@2025)
# DEMO_PASSWORD=

# Minutos sem leitura até o sensor aparecer como inativo (padrão 30)
# SENSOR_ONLINE_MINUTES=30
# Fuso das datas nas notificações (padrão America/Sao_Paulo)
# APP_TIMEZONE=America/Sao_Paulo

# --- Azure Storage (Atividade A02: Blob + Queue) ---------------------------
# Sem esta variável a API roda em modo local: comprovantes em disco
# (pasta storage-local) e fila em memória. Com ela, usa o Azure de verdade.
# Portal do Azure → Storage account → Segurança + rede → Chaves de acesso → Cadeia de conexão.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net
# Emulador local (Azurite, sem conta no Azure):
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Nomes (padrões abaixo; só minúsculas, números e hífen)
# AZURE_STORAGE_CONTAINER=comprovantes-coleta
# AZURE_STORAGE_QUEUE=coillect-notificacoes
# Leitura da fila: intervalo inicial e máximo em ms (padrão 1000 e 5000)
# QUEUE_POLL_MS=1000
# QUEUE_POLL_MAX_MS=5000
# Eventos JSON no log (base dos dashboards no Log Analytics). Padrão: ligado
# LOG_EVENTS=true
